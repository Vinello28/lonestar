{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoneStar",
  "version": "1.0.0",
  "identifier": "io.github.lonestar.istar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoneStar — i* 2.0 Modeling Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform iStar 2.0 (i*) goal-oriented modeling studio",
    "longDescription": "LoneStar is a fast, native cross-platform modeling application for iStar 2.0 (i*) built with Rust and Svelte 5 following Clean Architecture."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRjExMkU5MTYyRDEyRDYKUldUV0VpMFc2Ukx4ZWxhNUk3SEFaZE5xVSsxOWZsMUdVOXdVMndSVFRRWWp6ZG1rUGpFcmRuQ3UK",
      "endpoints": [
        "https://github.com/Vinello28/lonestar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
